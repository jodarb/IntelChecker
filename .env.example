# Host ports each service is exposed on (host:container). Change these if the
# defaults are already taken by another app running on this machine — no other
# file needs to change, docker-compose.yml reads these automatically.
#
# This is separate from backend/.env (API keys) — this file only controls ports
# and is read by Docker Compose itself, not passed into any container.
FRONTEND_PORT=8080
# Direct access to the API, bypassing the frontend's nginx proxy — useful for
# debugging or hitting the backend from another tool. Not required for normal
# use, since the frontend already proxies /api/* for you.
BACKEND_PORT=8000
