# VirusTotal — https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=

# AbuseIPDB — https://www.abuseipdb.com/account/api
# ABUSEIPDB_API_KEY=

# abuse.ch (shared by ThreatFox and URLhaus) — https://auth.abuse.ch/
# ABUSECH_AUTH_KEY=

# AlienVault OTX — https://otx.alienvault.com/api
# ALIENVAULT_API_KEY=

# Shodan — https://account.shodan.io/
# SHODAN_API_KEY=

# urlscan.io — https://urlscan.io/user/profile/
# URLSCAN_API_KEY=

# PhishTank — https://www.phishtank.com/api_register.php (optional, checkurl works without a key at lower priority)
# PHISHTANK_API_KEY=

# Criminal IP — https://www.criminalip.io/mypage/information (not yet integrated)
# CRIMINALIP_API_KEY=

# IPinfo — https://ipinfo.io/account/token
# IPINFO_API_KEY=

# Recorded Future — https://api.recordedfuture.com/
# RECORDED_FUTURE_API_KEY=

# ANY.RUN TI Lookup — https://app.any.run/ (API key from your account's API tab)
# ANYRUN_API_KEY=

# GreyNoise Community API — https://viz.greynoise.io/account/ (free, 50 lookups/week)
# GREYNOISE_API_KEY=

# Hybrid Analysis (Falcon Sandbox) — https://hybrid-analysis.com/my-account?tab=%23api-key-tab
# HYBRID_ANALYSIS_API_KEY=

# Google Safe Browsing — https://developers.google.com/safe-browsing/v4/get-started (Google Cloud API key with the Safe Browsing API enabled)
# GOOGLE_SAFE_BROWSING_API_KEY=

# OpenCTI (not yet integrated)
# OPENCTI_URL=
# OPENCTI_API_KEY=

# MISP — define as many instances as you want, each becomes its own source in the UI.
# Number them MISP_1, MISP_2, MISP_3... (any gaps or order are fine). Each instance
# needs at least NAME and URL; VERIFY_SSL defaults to true — set it to false for
# instances with a self-signed certificate.
#
# WEIGHT (Risk Score) and KNOWLEDGE_WEIGHT (Knowledge Score) are the instance's
# *initial* weights, on the same 0-10 scale as every other engine. Defaults: 0 and 9.
# Once the stack is running, all weights — MISP included — are managed from the
# Admin page in the UI; a value saved there takes precedence over these.
#
# Some MISP instances (common on government/CERT deployments) require mutual TLS —
# they reject the connection unless the client presents its own certificate, on top
# of the API key. If yours does, drop the cert (and key, if separate) in backend/certs/
# (gitignored) and reference them by filename with CLIENT_CERT/CLIENT_KEY. A combined
# cert+key PEM file only needs CLIENT_CERT.
#
# MISP_1_NAME=
# MISP_1_URL=
# MISP_1_KEY=
# MISP_1_VERIFY_SSL=true
# MISP_1_WEIGHT=0
# MISP_1_KNOWLEDGE_WEIGHT=9
# MISP_1_CLIENT_CERT=
# MISP_1_CLIENT_KEY=
